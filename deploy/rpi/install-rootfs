#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
    echo "install-rootfs must run as root inside the image chroot" >&2
    exit 1
fi

# shellcheck source=defaults.env
source /opt/mpfc/deploy/rpi/defaults.env
export DEBIAN_FRONTEND=noninteractive

cat > /usr/sbin/policy-rc.d <<'EOF_POLICY'
#!/bin/sh
exit 101
EOF_POLICY
chmod +x /usr/sbin/policy-rc.d
trap 'rm -f /usr/sbin/policy-rc.d' EXIT

apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates curl git jq rsync tmux htop \
    iproute2 iputils-ping netcat-openbsd socat tcpdump \
    python3 python3-venv python3-pip python3-dev build-essential \
    mosquitto mosquitto-clients openssh-server sudo \
    libffi-dev
apt-get clean
rm -rf /var/lib/apt/lists/*

if ! id mpfc >/dev/null 2>&1; then
    useradd --create-home --home-dir /home/mpfc --shell /bin/bash mpfc
fi
passwd -d mpfc >/dev/null
usermod -a -G dialout,systemd-journal mpfc

install -d -o mpfc -g mpfc -m 0755 /var/log/mpfc /run/mpfc

python3 -m venv /opt/mpfc/.venv
/opt/mpfc/.venv/bin/python -m pip install --upgrade pip setuptools wheel

# Install the deliberately narrow runtime dependency set used by the companion
# appliance. HiveLink is installed from the checked-out /opt/hivelink project,
# keeping MPFC, OCCID and HiveLink as the only source repositories required.
/opt/mpfc/.venv/bin/pip install -r /opt/mpfc/requirements-runtime.txt
if [[ -f /opt/hivelink/requirements.txt ]]; then
    /opt/mpfc/.venv/bin/pip install -r /opt/hivelink/requirements.txt
fi
/opt/mpfc/.venv/bin/pip install -e /opt/hivelink

rsync -a /opt/mpfc/deploy/rpi/rootfs/ /
install -m 0755 /opt/mpfc/deploy/rpi/run-mpfc /opt/mpfc/deploy/rpi/configure-fc
install -m 0755 /opt/mpfc/deploy/rpi/rootfs/usr/local/sbin/mpfc-runtime-config /usr/local/sbin/mpfc-runtime-config
chmod 0440 /etc/sudoers.d/mpfc

install -d -m 0755 /etc/mpfc
cat > /etc/mpfc/runtime.env <<EOF_RUNTIME
MPFC_CONFIG=/opt/mpfc/flight_cores/execution_host/config_appliance.yaml
OCCID_PATH=/opt/occid
MPFC_NODE_NAME=${MPFC_NODE_NAME}
MPFC_CONTROL_NODE=${MPFC_CONTROL_NODE}
MPFC_CONTROL_HOST=${MPFC_PI_CONTROL_IP}
MPFC_HIVELINK_PORT=${MPFC_HIVELINK_PORT}
MPFC_MAVLINK_CONNECTION=${MPFC_PI_PHYSICAL_MAVLINK_CONNECTION}
PYTHONUNBUFFERED=1
EOF_RUNTIME
chmod 0644 /etc/mpfc/runtime.env

install -d -m 0700 /etc/NetworkManager/system-connections
cat > /etc/NetworkManager/system-connections/mpfc-qemu.nmconnection <<EOF_NETWORK
[connection]
id=mpfc-qemu
type=ethernet
autoconnect=true

[ethernet]

[ipv4]
method=manual
address1=${MPFC_PI_GUEST_IP}/${MPFC_PI_PREFIX}
never-default=true

[ipv6]
method=disabled

[proxy]
EOF_NETWORK
chmod 0600 /etc/NetworkManager/system-connections/mpfc-qemu.nmconnection

# Make the primary UART available on real hardware. The deployment script still
# chooses the concrete tty device and baud with configure-fc.
if ! grep -Eq '^enable_uart=1$' /boot/firmware/config.txt; then
    printf '\nenable_uart=1\n' >> /boot/firmware/config.txt
fi

chown -R mpfc:mpfc /opt/mpfc /opt/occid /opt/hivelink
systemctl enable ssh.service mosquitto.service mpfc-runtime-config.service mpfc.service

rm -f /usr/sbin/policy-rc.d
trap - EXIT
