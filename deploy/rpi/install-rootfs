#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
    echo "install-rootfs must run as root inside the image chroot" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive

cat > /usr/sbin/policy-rc.d <<'EOF_POLICY'
#!/bin/sh
exit 101
EOF_POLICY
chmod +x /usr/sbin/policy-rc.d
trap 'rm -f /usr/sbin/policy-rc.d' EXIT

apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates curl git jq rsync tmux htop \
    iproute2 iputils-ping netcat-openbsd socat tcpdump \
    python3 python3-venv python3-pip python3-dev build-essential \
    mosquitto mosquitto-clients openssh-server sudo \
    libffi-dev
apt-get clean
rm -rf /var/lib/apt/lists/*

if ! id mpfc >/dev/null 2>&1; then
    useradd --create-home --home-dir /home/mpfc --shell /bin/bash mpfc
fi
passwd -d mpfc >/dev/null
usermod -a -G dialout,systemd-journal mpfc

install -d -o mpfc -g mpfc -m 0755 /var/log/mpfc /run/mpfc

python3 -m venv /opt/mpfc/.venv
/opt/mpfc/.venv/bin/python -m pip install --upgrade pip setuptools wheel

# MPFC requirements are authoritative, except HiveLink itself: the appliance
# deliberately uses the checked-out /opt/hivelink project rather than a PyPI
# copy so MPFC, OCCID and HiveLink are the only source repositories required.
grep -Ev '^[[:space:]]*hivelink([<=>!~ ].*)?$' /opt/mpfc/requirements.txt > /tmp/mpfc-requirements.txt
/opt/mpfc/.venv/bin/pip install -r /tmp/mpfc-requirements.txt
if [[ -f /opt/hivelink/requirements.txt ]]; then
    /opt/mpfc/.venv/bin/pip install -r /opt/hivelink/requirements.txt
fi
/opt/mpfc/.venv/bin/pip install -e /opt/hivelink
rm -f /tmp/mpfc-requirements.txt

rsync -a /opt/mpfc/deploy/rpi/rootfs/ /
install -m 0755 /opt/mpfc/deploy/rpi/run-mpfc /opt/mpfc/deploy/rpi/configure-fc
install -m 0755 /opt/mpfc/deploy/rpi/rootfs/usr/local/sbin/mpfc-runtime-config /usr/local/sbin/mpfc-runtime-config
chmod 0440 /etc/sudoers.d/mpfc

# Make the primary UART available on real hardware. The deployment script still
# chooses the concrete tty device and baud with configure-fc.
if ! grep -Eq '^enable_uart=1$' /boot/firmware/config.txt; then
    printf '\nenable_uart=1\n' >> /boot/firmware/config.txt
fi

chown -R mpfc:mpfc /opt/mpfc /opt/occid /opt/hivelink
systemctl enable ssh.service mosquitto.service mpfc-runtime-config.service mpfc.service

rm -f /usr/sbin/policy-rc.d
trap - EXIT
