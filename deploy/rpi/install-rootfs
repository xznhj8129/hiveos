#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
    echo "install-rootfs must run as root inside the image chroot" >&2
    exit 1
fi

: "${MPFC_PI_PASSWORD:=mpfc}"
export DEBIAN_FRONTEND=noninteractive

cat > /usr/sbin/policy-rc.d <<'EOF_POLICY'
#!/bin/sh
exit 101
EOF_POLICY
chmod +x /usr/sbin/policy-rc.d
trap 'rm -f /usr/sbin/policy-rc.d' EXIT

apt-get update
apt-get install -y --no-install-recommends \
    ca-certificates curl git jq rsync tmux htop \
    iproute2 iputils-ping netcat-openbsd socat tcpdump \
    python3 python3-venv python3-crcmod \
    mosquitto mosquitto-clients openssh-server sudo
apt-get clean
rm -rf /var/lib/apt/lists/*

if ! id mpfc >/dev/null 2>&1; then
    useradd --create-home --home-dir /home/mpfc --shell /bin/bash mpfc
fi
printf 'mpfc:%s\n' "${MPFC_PI_PASSWORD}" | chpasswd
usermod -a -G dialout,systemd-journal mpfc

install -d -o mpfc -g mpfc -m 0755 /var/log/mpfc /run/mpfc
install -d -m 0755 /opt/mpfc /opt/occid /opt/hivelink

# Create only the target interpreter environment here. Python application
# dependencies are cross-resolved and staged by the x86 host builder later;
# ARM pip is deliberately not part of the appliance build path.
rm -rf /opt/mpfc/.venv
python3 -m venv --without-pip --system-site-packages /opt/mpfc/.venv

# This is a pre-provisioned appliance, not an interactive Raspberry Pi OS
# first-boot image. Remove user-rename/banner state that otherwise causes SSH to
# warn that no valid user exists even though the mpfc account is already real.
rm -f /etc/ssh/sshd_config.d/rename_user.conf
rm -f /etc/sudoers.d/010_wiz-nopasswd
rm -rf /var/lib/userconf-pi

# Services that either belong to interactive first boot or to hardware absent
# from the Zero 2 W appliance are not part of this runtime. NetworkManager and
# wpa_supplicant remain available because the physical appliance may use them.
systemctl mask \
    userconfig.service \
    systemd-networkd-wait-online.service \
    rpi-eeprom-update.service \
    avahi-daemon.service \
    udisks2.service \
    sshswitch.service >/dev/null 2>&1 || true
systemctl enable ssh.service mosquitto.service >/dev/null

rm -f /usr/sbin/policy-rc.d
trap - EXIT
