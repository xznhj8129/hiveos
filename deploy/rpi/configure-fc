#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: sudo configure-fc <tty-device> [baud]

Examples:
  sudo configure-fc /dev/serial0 921600
  sudo configure-fc /dev/ttyUSB0 460800

Writes the physical appliance MAVLink endpoint to /etc/mpfc/runtime.env and
restarts MPFC. The VM does not use this command; it supplies a UDP override on
its MPFC_CONFIG disk.
USAGE
}

if [[ ${EUID} -ne 0 ]]; then
    echo "configure-fc must run as root" >&2
    exit 1
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
    usage >&2
    exit 2
fi

TTY_DEVICE=$1
BAUD=${2:-921600}

if [[ ${TTY_DEVICE} != /dev/* ]]; then
    echo "tty device must be an absolute /dev path: ${TTY_DEVICE}" >&2
    exit 2
fi
if [[ ! ${BAUD} =~ ^[0-9]+$ ]]; then
    echo "baud must be numeric: ${BAUD}" >&2
    exit 2
fi

install -d -m 0755 /etc/mpfc
cat > /etc/mpfc/runtime.env <<EOF_ENV
MPFC_CONFIG=/opt/mpfc/flight_cores/execution_host/config_appliance.yaml
OCCID_PATH=/opt/occid
MPFC_MAVLINK_CONNECTION=serial://${TTY_DEVICE}:${BAUD}
PYTHONUNBUFFERED=1
EOF_ENV
chmod 0644 /etc/mpfc/runtime.env

usermod -a -G dialout mpfc
systemctl restart mpfc.service

echo "MPFC FC endpoint: serial://${TTY_DEVICE}:${BAUD}"
