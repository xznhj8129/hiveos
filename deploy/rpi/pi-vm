#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
VM_DIR=${SCRIPT_DIR}/.vm
DEFAULT_IMAGE=${SCRIPT_DIR}/dist/mpfc-rpi-zero2w.img
IMAGE=${MPFC_PI_IMAGE:-${DEFAULT_IMAGE}}
SSH_PORT=${MPFC_PI_SSH_PORT:-2222}
MAVLINK_PORT=${MPFC_PI_MAVLINK_PORT:-14540}
SSH_KEY=${MPFC_PI_SSH_KEY:-${HOME}/.ssh/id_ed25519}

usage() {
    cat <<EOF_USAGE
Usage: ${0##*/} <command> [options]

Commands:
  up       Run a disposable Pi VM in the foreground
  start    Run it in the background
  stop     Stop a background VM
  ssh      SSH to the VM
  logs     Follow mpfc.service logs
  deploy   Rsync MPFC + sibling OCCID/HiveLink into the running VM and restart

Options used by up/start:
  --image PATH         Appliance raw image, default ${DEFAULT_IMAGE}
  --ssh-port PORT      Host SSH forward, default ${SSH_PORT}
  --mavlink-port PORT  Host UDP forward to guest 14540, default ${MAVLINK_PORT}
  --ssh-key PATH       SSH private key; PATH.pub is injected into the VM
EOF_USAGE
}

[[ $# -gt 0 ]] || { usage >&2; exit 2; }
COMMAND=$1
shift

while [[ $# -gt 0 ]]; do
    case "$1" in
        --image) IMAGE=$2; shift 2 ;;
        --ssh-port) SSH_PORT=$2; shift 2 ;;
        --mavlink-port) MAVLINK_PORT=$2; shift 2 ;;
        --ssh-key) SSH_KEY=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

mkdir -p "${VM_DIR}"
PID_FILE=${VM_DIR}/qemu.pid
CFG_IMAGE=${VM_DIR}/mpfc-config.img

ssh_base=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -p "${SSH_PORT}")
if [[ -f ${SSH_KEY} ]]; then
    ssh_base+=(-i "${SSH_KEY}")
fi
ssh_base+=(mpfc@127.0.0.1)

require_vm_files() {
    [[ -f ${IMAGE} ]] || { echo "image not found: ${IMAGE}" >&2; echo "build it with: sudo ${SCRIPT_DIR}/build-image" >&2; exit 1; }
    [[ -f ${IMAGE}.kernel8.img ]] || { echo "QEMU kernel sidecar missing: ${IMAGE}.kernel8.img" >&2; exit 1; }
    [[ -f ${IMAGE}.raspi3ap.dtb ]] || { echo "QEMU DTB sidecar missing: ${IMAGE}.raspi3ap.dtb" >&2; exit 1; }
}

make_config_disk() {
    for cmd in truncate mkfs.vfat mcopy; do
        command -v "${cmd}" >/dev/null || { echo "missing host command: ${cmd}" >&2; echo "install: sudo apt install dosfstools mtools" >&2; exit 1; }
    done
    rm -f "${CFG_IMAGE}"
    truncate -s 16M "${CFG_IMAGE}"
    mkfs.vfat -n MPFC_CONFIG "${CFG_IMAGE}" >/dev/null
    cat > "${VM_DIR}/runtime.env" <<EOF_ENV
MPFC_MAVLINK_CONNECTION=udp://:14540
EOF_ENV
    mcopy -o -i "${CFG_IMAGE}" "${VM_DIR}/runtime.env" ::runtime.env
    if [[ -f ${SSH_KEY}.pub ]]; then
        mcopy -o -i "${CFG_IMAGE}" "${SSH_KEY}.pub" ::authorized_keys
    else
        echo "warning: ${SSH_KEY}.pub not found; SSH helper commands will not work until a key is injected" >&2
    fi
}

qemu_args() {
    cat <<EOF_ARGS
-M
raspi3ap
-cpu
cortex-a53
-smp
4
-m
512M
-kernel
${IMAGE}.kernel8.img
-dtb
${IMAGE}.raspi3ap.dtb
-append
rw console=ttyAMA1,115200 root=/dev/mmcblk0p2 rootfstype=ext4 rootwait fsck.repair=yes net.ifnames=0
-drive
file=${IMAGE},format=raw,if=sd,index=0,snapshot=on
-usb
-drive
if=none,id=mpfccfg,format=raw,file=${CFG_IMAGE},readonly=on
-device
usb-storage,drive=mpfccfg
-netdev
user,id=net0,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22,hostfwd=udp:127.0.0.1:${MAVLINK_PORT}-:14540
-device
usb-net,netdev=net0
-nographic
-serial
mon:stdio
EOF_ARGS
}

run_qemu() {
    local daemonize=$1
    require_vm_files
    command -v qemu-system-aarch64 >/dev/null || { echo "missing qemu-system-aarch64" >&2; echo "install: sudo apt install qemu-system-arm" >&2; exit 1; }
    make_config_disk
    mapfile -t args < <(qemu_args)
    if [[ ${daemonize} == 1 ]]; then
        local daemon_args=()
        local i=0
        while (( i < ${#args[@]} )); do
            if [[ ${args[i]} == -nographic ]]; then
                ((i += 1))
                continue
            fi
            if [[ ${args[i]} == -serial ]]; then
                ((i += 2))
                continue
            fi
            daemon_args+=("${args[i]}")
            ((i += 1))
        done
        qemu-system-aarch64 "${daemon_args[@]}" -display none -serial null -monitor none -daemonize -pidfile "${PID_FILE}"
        echo "MPFC Pi VM started (pid $(cat "${PID_FILE}"), SSH 127.0.0.1:${SSH_PORT}, MAVLink UDP 127.0.0.1:${MAVLINK_PORT})"
    else
        echo "MPFC Pi VM: SSH 127.0.0.1:${SSH_PORT}, MAVLink UDP 127.0.0.1:${MAVLINK_PORT} -> guest :14540"
        exec qemu-system-aarch64 "${args[@]}"
    fi
}

case "${COMMAND}" in
    up)
        run_qemu 0
        ;;
    start)
        if [[ -f ${PID_FILE} ]] && kill -0 "$(cat "${PID_FILE}")" 2>/dev/null; then
            echo "VM already running: pid $(cat "${PID_FILE}")" >&2
            exit 1
        fi
        run_qemu 1
        ;;
    stop)
        [[ -f ${PID_FILE} ]] || { echo "VM is not running"; exit 0; }
        pid=$(cat "${PID_FILE}")
        if kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}"
        fi
        rm -f "${PID_FILE}"
        ;;
    ssh)
        exec "${ssh_base[@]}"
        ;;
    logs)
        exec "${ssh_base[@]}" journalctl -fu mpfc.service
        ;;
    deploy)
        command -v rsync >/dev/null || { echo "missing rsync" >&2; exit 1; }
        REPO_ROOT=$(cd -- "${SCRIPT_DIR}/../.." && pwd)
        OCCID_PATH=$(cd -- "${REPO_ROOT}/.." && pwd)/occid
        HIVELINK_PATH=$(cd -- "${REPO_ROOT}/.." && pwd)/hivelink
        [[ -d ${OCCID_PATH} && -d ${HIVELINK_PATH} ]] || { echo "expected sibling occid and hivelink checkouts" >&2; exit 1; }
        RSYNC_SSH="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p ${SSH_PORT}"
        [[ -f ${SSH_KEY} ]] && RSYNC_SSH+=" -i ${SSH_KEY}"
        common_excludes=(--exclude=.git --exclude='__pycache__' --exclude='*.pyc' --exclude='.venv' --exclude='deploy/rpi/.build' --exclude='deploy/rpi/.cache' --exclude='deploy/rpi/dist' --exclude='deploy/rpi/.vm')
        rsync -az --delete "${common_excludes[@]}" -e "${RSYNC_SSH}" "${REPO_ROOT}/" mpfc@127.0.0.1:/opt/mpfc/
        rsync -az --delete --exclude=.git --exclude='__pycache__' -e "${RSYNC_SSH}" "${OCCID_PATH}/" mpfc@127.0.0.1:/opt/occid/
        rsync -az --delete --exclude=.git --exclude='__pycache__' -e "${RSYNC_SSH}" "${HIVELINK_PATH}/" mpfc@127.0.0.1:/opt/hivelink/
        "${ssh_base[@]}" /opt/mpfc/.venv/bin/pip install -e /opt/hivelink
        "${ssh_base[@]}" sudo /usr/bin/systemctl restart mpfc.service
        ;;
    *)
        echo "unknown command: ${COMMAND}" >&2
        usage >&2
        exit 2
        ;;
esac
